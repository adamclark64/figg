{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/factory/check-private-files.sh)",
      "Bash(scripts/factory/check-commits.sh *)",
      "Bash(scripts/factory/check-rules.sh *)",
      "Bash(mkdir -p /tmp/factory)",
      "Bash(mkdir -p specs/*)",
      "Bash(cp specs/_template/spec.md specs/*)",
      "Bash(gh api --method GET repos/adamclark64/figg/*)",
      "Bash(gh api --method POST repos/adamclark64/figg/pulls *)",
      "Bash(gh api --method POST repos/adamclark64/figg/issues/*/labels *)",
      "Bash(gh api --method DELETE repos/adamclark64/figg/issues/*/labels/factory:*)",
      "Bash(gh api --method POST repos/adamclark64/figg/issues/*/comments *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree *)",
      "Bash(git ls-remote *)",
      "Bash(git cat-file *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git fetch origin*)",
      "Bash(git switch factory/*)",
      "Bash(git switch -c factory/* origin/*)",
      "Bash(git merge --ff-only origin/factory/*)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git push origin factory/*)",
      "Bash(git push -u origin factory/*)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *repos/adamclark64/figg/merges*)",
      "Bash(gh api *-X *)",
      "Bash(gh api --method * --method *)",
      "Bash(gh api *git/refs*)",
      "Bash(gh api *repos/adamclark64/figg/labels*)",
      "Bash(gh api *secrets*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(gh repo edit*)",
      "Bash(gh secret*)",
      "Bash(gh label*)",
      "Bash(git push* main*)",
      "Bash(git push*:main*)",
      "Bash(git push*refs/heads/main*)",
      "Bash(git push*--force*)",
      "Bash(git push*-f *)",
      "Bash(git push*+*)",
      "Bash(git push*--delete*)",
      "Bash(git push*-d *)",
      "Bash(git push* :*)",
      "Bash(git push*--mirror*)",
      "Bash(git push*--all*)",
      "Bash(git push*--tags*)",
      "Bash(git branch -D*)",
      "Bash(git reset --hard*)",
      "Bash(git -C *)",
      "Bash(git -c *)"
    ]
  }
}
